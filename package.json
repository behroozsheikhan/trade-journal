{
  "name": "trade-journal",
  "version": "1.0.0",
  "description": "ژورنال ترید کریپتو — Crypto Trading Journal desktop app (Electron + React + TypeScript + SQLite)",
  "main": "dist-electron/main.js",
  "author": "behroozsheikhan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n ui,main,preload,app \"npm:dev:ui\" \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:app\"",
    "dev:ui": "vite",
    "dev:main": "vite build --config vite.main.config.ts --watch",
    "dev:preload": "vite build --config vite.preload.config.ts --watch",
    "dev:app": "wait-on dist-electron/main.js dist-electron/preload.js tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run typecheck && npm run build:ui && npm run build:main && npm run build:preload",
    "build:ui": "vite build",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dist": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win --publish never",
    "postinstall": "node scripts/postinstall.mjs",
    "test:e2e:sandbox": "node scripts/run-e2e-sandbox.mjs",
    "pretest": "node scripts/ensure-node-abi.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "jsdom": "^25.0.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  }
}
